# --- HTTP ---
# Port the service listens on.
PORT=8787

# Allowed CORS origin (the SPA). Must match exactly, including scheme + port.
CORS_ORIGIN=http://localhost:5173

# --- PocketID / OIDC ---
# Issuer URL of your PocketID instance. Used to validate the access token `iss`.
OIDC_ISSUER=https://id.example.com

# JWKS endpoint. Optional — defaults to ${OIDC_ISSUER}/.well-known/jwks.json
# OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json

# Expected `aud` claim of the PocketID access token (the API audience / client id).
OIDC_AUDIENCE=uav-signatures

# --- Persistence (mount these on a persistent volume in production) ---
# SQLite database file (signing_log + signatures + archive).
DB_PATH=./data/signatures.db

# Ed25519 signing key (PKCS#8 PEM). Generated on first boot if absent.
# Treat as a secret and BACK IT UP — losing it makes existing signatures unverifiable.
SIGNING_KEY_PATH=./data/signing-key.pem

# Directory where archived PDFs are written (in addition to the SQLite blob).
ARCHIVE_DIR=./data/archive
