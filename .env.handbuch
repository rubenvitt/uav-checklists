# Nur für die Handbuch-Aufnahmen (landing/tools/screenshots/): `pnpm dev --mode handbuch`.
#
# Erfundene Adressen (.invalid ist reserviert und löst nie auf). Die
# Aufnahmeskripte beantworten Anmeldung und Suchlage selbst (Playwright
# `route`), es gibt also keinen echten Server dahinter. Ohne angemeldeten
# Nutzer im Speicher bleibt alles wie im öffentlichen Betrieb.
VITE_SIGN_API_URL=https://sign.handbuch.invalid
VITE_OIDC_AUTHORITY=https://id.handbuch.invalid
VITE_OIDC_CLIENT_ID=flugmappe-handbuch
VITE_SUCHLAGE_URL=https://suchlage.handbuch.invalid
