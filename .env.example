# Optional signature backend (Phase 2/3).
#
# Leave ALL of these unset for the default public deployment: the app stays
# fully usable WITHOUT login, and no e-signature / login UI is shown
# (graceful degradation). No requests are made when VITE_SIGN_API_URL is empty.

# Base URL of the signature backend (server/). Enables the e-signature feature.
# VITE_SIGN_API_URL=https://sign.example.org

# PocketID OIDC issuer/authority. Required (together with the client id) to
# offer the optional login. Public client, Authorization Code + PKCE, no secret.
# VITE_OIDC_AUTHORITY=https://id.example.org

# PocketID public client id registered for this SPA.
# Redirect URI must be <origin>/auth/callback.
# VITE_OIDC_CLIENT_ID=uav-checklists

# Optional: Suchlage (Lagebild der Drohnen-Telemetrie), SUL-69.
# Base URL of a Suchlage instance; the Flugmappe calls its interface under
# /api/flugmappe/v1 with the PocketID access token (login above required).
# Leave unset for the public deployment: no Suchlage UI, no requests.
# In Suchlage, settings "Flugmappe" must contain this SPA's client id
# (VITE_OIDC_CLIENT_ID) and this app's origin.
# VITE_SUCHLAGE_URL=https://suchlage.example.org
